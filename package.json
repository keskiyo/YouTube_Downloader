{
	"name": "youtube_downloader",
	"version": "1.0.0",
	"description": "Desktop and web video downloader for YouTube, Rutube and VK Video",
	"author": "Maks",
	"private": true,
	"workspaces": [
		"apps/*"
	],
	"module": "index.ts",
	"type": "module",
	"main": "desktop/main.cjs",
	"scripts": {
		"dev": "concurrently \"bun --filter web dev\" \"bun --filter server dev\"",
		"desktop": "electron desktop/main.cjs",
		"dev:web": "bun --filter web dev",
		"dev:server": "bun --filter server dev",
		"build:web": "bun --filter web build",
		"preview:web": "bun --filter web preview"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"concurrently": "^9.2.1",
		"electron": "^42.3.3"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"react-router-dom": "^7.15.1"
	}
}
